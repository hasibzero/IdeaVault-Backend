# ideavault-server (backend) - Vercel environment variables
# Copy this file to .env locally for development.
# In production, add these in: Vercel Project -> Settings -> Environment Variables

# URL of the DEPLOYED frontend, e.g. https://your-frontend.vercel.app
# Used for CORS allow-list and the JWKS URL.
CLIENT_URL=

# MongoDB connection string
MONGO_URI=

# Better Auth secret (must match the frontend's BETTER_AUTH_SECRET)
BETTER_AUTH_SECRET=

# Optional: extra comma-separated origins allowed for CORS
# ALLOWED_ORIGINS=https://a.vercel.app,https://b.vercel.app

# Local dev port
PORT=5000
